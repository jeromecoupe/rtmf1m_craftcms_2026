{# template to extend #}
{% extends "_layouts/base.twig" %}

{# Template variables #}
{#
  A part si on l'interdit explicitement (with_context: false), les variables définies dans un template sont accessible par tous les autres templates inclus ou étendus (Contexte global de Twig)
  - Une variable définie dans ce template est accessible dans le template qui est étendu (layouts/base.twig)
#}
{% set metaTitle = entry.seoTitle ?? "Music stories and interviews" %}
{% set metaDescription = entry.seoDescription ?? entry.homeIntro %}
{% set metaUrl = entry.url %}
{% set metaImage = "#{ alias('@baseUrl/dist/img/socialmedia.jpg')}" %}

{# content block #}
{% block content %}

  <main class="maincontent">
    <div class="section">
      <div class="wrapper wrapper--md">
        {# 
          Craft fait du routing
          - Il sait que quand on lui demande une URL qui correspond à celle de la homepage, il doit charger le template index.twig (on lui a dit quand on a créé la section)
          - Il sait aussi que la section homepage ne contient qu'une et une seule entry (puisque c'est une section de type single)
          - Il sait donc à quelle entry précisément correspond cette URL et quel template il doit charger
            - Il rend automatiquement disponible dans ce template une variable "entry" qui est ... un gros objet ... qui contient tous les champs de la seule et unique entry de la setion homePage.
        #}
        <div class="homeintro">
          <div class="homeintro__main">
            <h1 class="sr-only">Musicmag</h1>
            <img
              src="dist/img/biglogo.svg"
              class="homeintro__logo"
              alt="Musicmag logo"
              width="696"
              height="96"
              decoding="async" />
            <p class="homeintro__tagline">
              <span>{{ entry.homeTagline }}</span>
            </p>
          </div>
          <p class="homeintro__text">{{ entry.homeIntro }}</p>
        </div>
      </div>
    </div>

    {# 1. LATEST STORIES #}
    {#
      - On va chercher des entries 
      - Qui sont dans la section "stories"
      - Classées par pubDate décroissantes
      - On limite à 2 entries
    #}

    {% set latestStoriesQuery = craft.entries()
      .section("stories")
      .orderBy("postDate DESC")
      .limit(2) %}
    
    {# On veut uniquement les IDs des entries pour filtrer les stories random plus tard > on appelle .ids() #}
    {% set latestStoriesIds = latestStoriesQuery.ids() %}
    {# On veut les entries sous forme de tableau d'objets avec les champs etc. > on appelle .all() #}
    {% set latestStories = latestStoriesQuery.all() %}
    
    <div class="section">
      <div class="wrapper">
        <h2 class="smalltitle">Latest Stories</h2>
        {#
          On boucle sur le tableau d'objets, chaque fois qu'on en trouve un, on le met dans une variable "item" et on affiche les propriétés de chaque objet avec les "handles" des champs qu'on a attachés aux entries via le entry_type de la section

          Inclusion du template "_includes/storycard.twig"
          - on lui passe la variable 'item' qu'on assigne à la variable 'entry'
          - on l'isole du contexte de Twig (cet include n'a accès à aucune variable à part celles qu'on lui passe explicitement)
        #}
        {% for item in latestStories %}

          {% if loop.first %}<ul class="grid grid--gap grid--2cols-md">{% endif %}
            <li>
              {{ include("_includes/storycard.twig", {
                entry: item,
                isBig: true
              }, with_context: false) }}
            </li>
          {% if loop.last %}</ul>{% endif %}

        {% else %}

          <p>No stories found</p>

        {% endfor %}
      </div>
    </div>

    {# 2. RANDOM STORIES #}
    {# 
      Création d'une variable randomStories
      - On va chercher des entries 
      - Qui sont dans la section "stories"
      - Classées par random
      - Limité à 6 (on a besoin de 4 entries pour l'affichage et on peut avoir deux doublons max avec les latest entries > on en prend 6 pour être certains)
      - On utilise .collect() plutôt que .all() pour avoir une collection, qui nous donne accès à des méthodes pratiques pour manipuler des collections: ici .whereNotIn() et .slice()
    #}
    {% set randomStories = craft.entries()
      .section("stories")
      .orderBy("RAND()")
      .limit(8)
      .collect() %}

    {% set randomStoriesFiltered = randomStories
      .whereNotIn('id', latestStoriesIds)
      .slice(0, 6) %}
    
    <div class="section">
      <div class="wrapper">
        <h2 class="smalltitle">From the archives</h2>
        {% for item in randomStoriesFiltered %}

          {% if loop.first %}<ul class="grid grid--gap grid--2cols-sm grid--3cols-md">{% endif %}
            <li>
              {{ include("_includes/storycard.twig", {
                entry: item
              }, with_context: false) }}
            </li>
          {% if loop.last %}</ul>{% endif %}

        {% else %}

          <p>No stories found</p>

        {% endfor %}
      </div>
    </div>

  </main>
{% endblock %}