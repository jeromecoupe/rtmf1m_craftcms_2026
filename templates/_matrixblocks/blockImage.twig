{% set entry = entry ?? null %}
{% set img = entry.mxImage.one() ?? null %}
{% set caption = entry.commonCaption ?? null %}

<div class="story__bodymedia">
    <figure class="figure">
        {% if img %}
            <img
                src="{{ img.getUrl({ width: 800 }) }}"
                srcset="
                    {{ img.getUrl({ width: 800 }) }} 800w,
                    {{ img.getUrl({ width: 1024 }) }} 1024w,
                    {{ img.getUrl({ width: 1500 }) }} 1500w
                "
                sizes="auto"
                class="fluidimg"
                width="{{ img.width }}"
                height="{{ img.height }}"
                loading="lazy"
                decoding="async"
                alt=""
            />
        {% endif %}
        <figcaption class="figure__caption">
            <p>
            {{ entry.commonCaption }}
            </p>
        </figcaption>
    </figure>
</div>
