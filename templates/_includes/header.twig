<header class="siteheader">
  <div class="wrapper">
    <div class="siteheader__content">
      <div class="siteheader__logo">
        <a href="/">
          <img
            src="/dist/img/logo.svg"
            alt="Musicmag"
            width="102"
            height="13"
            decoding="async" />
        </a>
      </div>
      <div class="siteheader__nav">
        {{ include("_includes/mainnav.twig") }}
      </div>
      <div class="siteheader__hamburger">
        <button
          class="hamburger"
          type="button"
          commandfor="mobilemenu"
          command="show-popover">
          <span class="sr-only">Open navigation</span>
          <img
            src="/dist/img/icon_hamburger.svg"
            width="36"
            height="36"
            aria-hidden="true"
            alt="" />
        </button>
      </div>
    </div>
  </div>
  <div
    class="mobilemenu"
    id="mobilemenu"
    popover="auto">
    <div class="mobilemenu__content">
      <div class="mobilemenu__actions">
        <button
          class="mobilemenu__close"
          type="button"
          commandfor="mobilemenu"
          command="hide-popover">
          <span class="sr-only">Close navigation</span>
          <img
            src="/dist/img/icon_close.svg"
            width="36"
            height="36"
            aria-hidden="true"
            alt="" />
        </button>
      </div>
      <div class="mobilemenu__main">
        {{ include("_includes/mobilenav.twig") }}
      </div>
    </div>
  </div>
</header>