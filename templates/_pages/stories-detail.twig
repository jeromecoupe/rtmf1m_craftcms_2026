{# template to extend #}
{% extends "_layouts/base.twig" %}

{# Template variables #}
{% set socialImg = entry.storyCoverImage.one() %}
{% set socialImgUrl = socialImg.getUrl({ width: 1024, height: 1024 }) %}

{% set metaTitle = entry.seoTitle ?? entry.title %}
{% set metaDescription = entry.seoDescription ?? entry.commonIntro %}
{% set metaImage = socialImgUrl ?? "#{ alias('@baseUrl/dist/img/socialmedia.jpg')}" %}
{% set metaUrl = entry.url %}

{% block content %}
  {# 
    Craft fait du routing
    - Quand il est confronté à une URL qui a pour format "/stories/{slug}" il doit charger ce template-ci
    - Quand le slug dans l'URL esty celui d'une entry de la section stories, craft créé automatiquement une variable "entry" pour nous qui contient tous les champs de l'entry qui correspond au slug 
  #}
  <main class="maincontent">
    <div class="section">
      <div class="story">
        <div class="wrapper">
          <div class="story__header">
            <div class="story__headermain">
              <p class="story__type">{{ entry.storyType.value }}</p>
              <h1 class="story__title">
                {{ entry.title }}
              </h1>
            </div>
            <div class="story__headerinfo">
              <p class="story__date">{{ entry.postDate|date("F j, Y") }}</p>
              <p class="story__author">{{ entry.storyAuthor }}</p>
            </div>
          </div>
        </div>
        <div class="story__banner">
          {# 
              - storyImage est un champs relationnel qui lie vers un Asset. 
              - Pour tous les champs relationnels, Craft retourne un tableau d'objet (même s'il n'y a qu'un seul Asset comme ici)
              - on prend le premier (et seul) objet du tableau avec .one()
            #}
          {% set img = entry.storyCoverImage.one() %}

          {% if img %}
            <picture>
              <source
                width="1500"
                height="844"
                srcset="
                    {{ img.getUrl({ width: 1024, height: 576 }) }} 1024w,
                    {{ img.getUrl({ width: 1500, height: 844 }) }} 1500w
                  "
                media="(width >= 700px)"
                sizes="100vi"
              />
              <img
                src="{{ img.getUrl({ width: 800, height: 600 }) }}"
                class="fluidimg fluidimg--full"
                width="800"
                height="600"
                alt="{{ img.alt }}"
              />
            </picture>
          {% endif %}
        </div>
        <div class="story__content">
          <div class="wrapper">
            <div class="story__body">
              <div class="story__bodytext">
                <p class="lead">
                  {{ entry.commonIntro }}
                </p>
              </div>  

              {# 
                Modularbody est un champs Matrix
                - qui contient des entries (qu'on appelle item ici)
                - qui sont d'un certin type en fonction de leur entryType 
                - on prend toutes les entries dans la champ avec .all()
                - Craft nous renvoie (comme d'hab) un gros tableau d'objets entries
               #}
              {% set allBlocks = entry.modularBody.all() %}
              
              {#
                On boucle sur toutes les entries du tableau d'objets
                - chaque fois qu'on en trouve une on l'a&ssigne à une variable item 
                - avec un swith / case on checke le type de chaque entry item
                - suivant le type qu'on trouve on include un template différent dont la mission est d'afficher tous les champs de l'entry item
                  - on passe l'entry à l'include en l'assignant à une variable entry (qu'on va utiliser dans les includes pour afficher les champs)
              #}
              {% for item in allBlocks %}
                {% switch item.type.handle %}
                  {% case "blockText" %}
                    {{ include("_matrixblocks/blockText.twig", { 
                      entry: item 
                    }, with_context: false) }}
                  {% case "blockQuote" %}
                    {{ include("_matrixblocks/blockQuote.twig", { 
                      entry: item 
                    }, with_context: false) }}
                  {% case "blockVideo" %}
                    {{ include("_matrixblocks/blockVideo.twig", { 
                      entry: item 
                    }, with_context: false) }}
                  {% case "blockImage" %}
                    {{ include("_matrixblocks/blockImage.twig", { 
                      entry: item 
                    }, with_context: false) }}
                {% endswitch %}
              {% endfor %}
              
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

{% endblock %}
