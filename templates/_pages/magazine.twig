{# template à étendre #}
{% extends "_layouts/base.twig" %}

{# meta variables #}
{% set metaTitle = "Magazine" %}
{% set metaDescription = "Online articles, interviews and stories about the world of music. Created by humans for humans." %}
{% set metaUrl = entry.url %}
{% set metaImage = "#{ alias('@baseUrl/dist/img/socialmedia.jpg')}" %}

{# page content #}
{% block content %}
<main class="maincontent">
  <div class="section">
    <div class="wrapper">
      <div class="grid grid--colgap grid--2cols-md">
        <div>
          <h1 class="h1">{{ entry.title }}</h1>
        </div>
        <div class="richtext">
          {{ entry.magazineIntro }}
        </div>
      </div>
    </div>
  </div>

