{
  "name": "rtmf1m_craftcms_2026",
  "version": "1.0.0",
  "description": "musicmag website",
  "homepage": "https://github.com/jeromecoupe/rtmf1m_craftcms_2026#readme",
  "bugs": {
    "url": "https://github.com/jeromecoupe/rtmf1m_craftcms_2026/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeromecoupe/rtmf1m_craftcms_2026.git"
  },
  "license": "ISC",
  "author": "Chinook Baix",
  "type": "module",
  "scripts": {
    "clean": "rimraf \"./web/dist\"",
    "css:dev": "lightningcss --bundle \"./src/css/styles.css\" -o \"./web/dist/css/styles.css\"",
    "css:prod": "npm run css:dev -- --minify",
    "js:dev": "esbuild --bundle \"./src/js/scripts.js\" --outfile=\"./web/dist/js/scripts.js\"",
    "js:prod": "npm run js:dev -- --minify",
    "copy:images": "copyfiles -u 1 \"./src/img/**/*\" \"./web/dist/\"",
    "copy:fonts": "copyfiles -u 1 \"./src/fonts/**/*\" \"./web/dist/\"",
    "watch:css": "onchange \"./src/css/**/*\" -- npm run css:dev",
    "watch:js": "onchange \"./src/js/**/*\" -- npm run js:dev",
    "build": "npm run clean && concurrently \"npm run copy:images\" \"npm run copy:fonts\" \"npm run css:prod\" \"npm run js:prod\"",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:js\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.2",
    "lightningcss-cli": "^1.33.0",
    "onchange": "^7.1.0",
    "rimraf": "^6.1.3"
  },
  "allowScripts": {
    "lightningcss-cli@1.33.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
