# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=

# Database credential
CRAFT_DB_DATABASE=
CRAFT_DB_SERVER=
CRAFT_DB_USER=
CRAFT_DB_PASSWORD=
CRAFT_DB_DRIVER="mysql"
CRAFT_DB_PORT="3306"

# mailpit (ddev)
MAILPIT_SMTP_HOSTNAME="127.0.0.1"
MAILPIT_SMTP_PORT="1025"

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true
CRAFT_WEB_ROOT="/your/server/path/to/web"

# custom env variables
PRIMARY_SITE_URL="https://musicmag.ddev.site/"
CP_TRIGGER="admin"

# assets end variables (no trailing slash)
ASSETS_BASE_PATH="/your/server/path/to/web"
ASSETS_BASE_URL="https://musicmag.ddev.site"


